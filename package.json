{
  "name": "prueba-inferencial-macajan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prueba diagnóstica de comprensión lectora inferencial — I.E. Macaján, grado noveno",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:create": "wrangler d1 create prueba-inferencial",
    "db:migrate:local": "wrangler d1 migrations apply prueba-inferencial --local",
    "db:migrate:remote": "wrangler d1 migrations apply prueba-inferencial --remote",
    "db:reset:local": "wrangler d1 execute prueba-inferencial --local --command \"SELECT 1\""
  },
  "dependencies": {
    "hono": "^4.10.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.13.0",
    "recharts": "^3.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.16.3",
    "@fontsource-variable/nunito": "^5.2.9",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "wrangler": "^4.124.0"
  }
}
