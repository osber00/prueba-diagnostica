{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Define la URL final: https://<name>.<tu-subdominio>.workers.dev
  "name": "prueba-inferencial-macajan",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // El plugin de Vite apunta automáticamente al build del cliente.
  // "single-page-application" hace que cualquier ruta desconocida sirva index.html.
  "assets": {
    "not_found_handling": "single-page-application"
  },

  // Base de datos de producción en Cloudflare D1.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prueba-inferencial",
      "database_id": "09667024-8515-44a9-874b-2de08634dac1",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  }

  // Secrets (NO van aquí, se cargan con `wrangler secret put`):
  //   ADMIN_MASTER_CODE  — código de acceso al panel gestor
  //   SESSION_SECRET     — cadena aleatoria de 32+ bytes para firmar sesiones
  // En local se leen desde .dev.vars
}
